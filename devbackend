#!/usr/bin/env bash

# Exit in case of error
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"
source "$ROOT_DIR/scripts/dev-common.sh"

LOG_LEVEL_OVERRIDE="${LOG_LEVEL-}"
if [[ "${1-}" == "d" ]]; then
  LOG_LEVEL_OVERRIDE="DEBUG"
  shift
  echo "Backend debug logging enabled (LOG_LEVEL=DEBUG)."
fi

if [[ $# -gt 0 ]]; then
  echo "Usage: ./devbackend [d]"
  exit 1
fi

prepare_backend_dev
run_backend_devserver "$LOG_LEVEL_OVERRIDE"
