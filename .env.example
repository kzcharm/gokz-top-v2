# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and acquire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com
API_HOST=api.localhost
FRONTEND_HOSTNAME=dashboard.localhost
FRONTEND_HOST_RULE=Host(`dashboard.localhost`)
ADMINER_HOST=adminer.localhost
API_REDIRECT_HOST=
FRONTEND_REDIRECT_HOST=

# Used by the backend for Steam login callbacks and redirects to the frontend
FRONTEND_HOST=http://localhost:5173
# Used by OAuth flows that must redirect back to the backend
BACKEND_PUBLIC_URL=http://localhost:8000
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="GOKZ.TOP"
STACK_NAME=gokz-top-v2

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com,https://cs2kz.org"
SECRET_KEY=change-me
SUPER_USER_STEAMID64=76561198000000000
STEAM_API_KEY=change-me

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

SENTRY_DSN=

# MaxMind GeoIP
GEOIP_DATA_DIR=./.geoip
GEOIP_CITY_DB_PATH=../.geoip/GeoLite2-City.mmdb

GEOIPUPDATE_ACCOUNT_ID=change-me
GEOIPUPDATE_LICENSE_KEY=change-me
GEOIPUPDATE_EDITION_IDS=GeoLite2-City
GEOIPUPDATE_FREQUENCY=24

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
DOCKER_IMAGE_REPLAY_VIEWER=replayviewer

# Standalone replay viewer. In production, REPLAY_VIEWER_RESOURCES_DIR should
# point at the existing exported map resources directory on the Docker host.
REPLAY_VIEWER_HOST=http://localhost:5180
REPLAY_VIEWER_HOSTNAME=replays.localhost
REPLAY_VIEWER_RESOURCES_DIR=./replay-viewer/resources

TWITCH_CLIENT_ID=change-me
TWITCH_CLIENT_SECRET=change-me
YOUTUBE_CLIENT_ID=change-me
YOUTUBE_CLIENT_SECRET=change-me
YOUTUBE_API_KEY=change-me
# Production-only YouTube upload notifications. Use a high-entropy shared secret.
YOUTUBE_WEBSUB_ENABLED=false
YOUTUBE_WEBSUB_SECRET=

# Cloudflare R2 object storage. Leave blank to disable R2-backed features.
# Deployments should use separate production and staging buckets/public URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_MULTIPART_UPLOAD_THRESHOLD_BYTES=268435456
R2_MULTIPART_PART_SIZE_BYTES=67108864

# Production-only map BSP distribution worker.
MAP_FILE_DATA_DIR=./.maps
MAP_FILE_STORAGE_DIR=../.maps
MAP_DISTRIBUTION_HOUR_UTC=3
MAP_DISTRIBUTION_BZ2_MAX_BYTES=150000000
STEAMCMD_PATH=steamcmd
SEVENZIP_PATH=7z
